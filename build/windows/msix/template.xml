<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="elemento-nexus.exe"
        Arguments=""
        InstallLocation="C:\Program Files\Elemento\Elemento Nexus">
    </Installer>
    <PackageInformation
        PackageName="Elemento Nexus"
        PackageDisplayName="Elemento Nexus"
        PublisherName="CN=Elemento"
        PublisherDisplayName="Elemento"
        Version="0.1.0.0"
        PackageDescription="Elemento Nexus">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.elemento.nexus"
                Description="Elemento Nexus"
                DisplayName="Elemento Nexus"
                ExecutableName="elemento-nexus.exe"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>Elemento Nexus</DisplayName>
            <PublisherDisplayName>Elemento</PublisherDisplayName>
            <Description>Elemento Nexus</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="elemento-nexus.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
